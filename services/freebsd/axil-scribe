#!/bin/sh
#
# $FreeBSD$
#
# PROVIDE: axil_scribe
# REQUIRE: LOGIN cleanvar
# KEYWORD: shutdown
#
# Add the following line to /etc/rc.conf to enable axil-scribe:
# axil_scribe_enable="YES"
#

. /etc/rc.subr

name="axil_scribe"
rcvar="axil_scribe_enable"

command="@PREFIX@/bin/axil"
command_args="-A -d -B 33554432 -p 8095 -m @PREFIX@/lib/libaxil-scribe.so"

load_rc_config $name
: ${axil_scribe_enable:="NO"}
: ${axil_scribe_pack_dir:="@PREFIX@/share/axil-scribe/packs/generic"}
export SCRIBE_PACK_DIR="${SCRIBE_PACK_DIR:-${axil_scribe_pack_dir}}"
export SCRIBE_WASM_PATH="${SCRIBE_WASM_PATH:-@PREFIX@/share/axil-scribe/htdocs/scribe_ux.wasm}"

run_rc_command "$1"

[Unit]
Description=Axil Scribe Document OCR & HITL Verification Server (:8095)
After=network.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SCRIBE_DATA_DIR=%h/.local/share/axil-scribe/data
Environment=SCRIBE_PACK_DIR=@PREFIX@/share/axil-scribe/packs/generic
Environment=SCRIBE_WASM_PATH=@PREFIX@/share/axil-scribe/htdocs/scribe_ux.wasm
ExecStart=@PREFIX@/bin/axil -A -d -B 33554432 -p 8095 -m @PREFIX@/lib/libaxil-scribe
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
